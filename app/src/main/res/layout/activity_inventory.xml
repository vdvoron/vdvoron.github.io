<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inventoryLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/background_light">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backArrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_24"
            android:contentDescription="@string/back"
            app:tint="@color/text_primary"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/inventoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inventory_screen"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/backArrow"
            app:layout_constraintEnd_toStartOf="@id/smsButton"
            app:layout_constraintHorizontal_bias="0.5" />

        <LinearLayout
            android:id="@+id/smsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/smsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sms"
                android:contentDescription="@string/sms_settings"
                android:tint="@color/text_primary" />

            <TextView
                android:id="@+id/smsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sms_settings"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Input Row -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/itemNameInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/light_blue"
            android:hint="@string/hint_item_name"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <!-- allow signed numbers for testing negatives -->
        <EditText
            android:id="@+id/itemQtyInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/light_blue"
            android:hint="@string/hint_qty"
            android:inputType="numberSigned"
            android:autofillHints="none"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/addItemButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/add_button"
            android:textColor="@color/white"
            android:backgroundTint="@color/light_blue" />
    </LinearLayout>

    <!-- NEW Controls Row: Search + Sort -->
    <LinearLayout
        android:id="@+id/controlsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/inputRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp"
            android:hint="Search by name"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/searchBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Search"
            android:textColor="@color/white"
            android:backgroundTint="@color/light_blue"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/sortNameBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Sort Name"
            android:textColor="@color/white"
            android:backgroundTint="@color/light_blue"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/sortQtyBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Sort Qty"
            android:textColor="@color/white"
            android:backgroundTint="@color/light_blue" />
    </LinearLayout>

    <!-- Inventory Table sits BELOW controls row -->
    <TableLayout
        android:id="@+id/inventoryTable"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:stretchColumns="*"
        app:layout_constraintTop_toBottomOf="@id/controlsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow>
            <TextView
                android:text="@string/header_item"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:padding="8dp" />
            <TextView
                android:text="@string/header_quantity"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:padding="8dp" />
            <TextView
                android:text="@string/header_action"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:padding="8dp" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>